# NextAuth Configuration
# Run `openssl rand -base64 32` or visit https://generate-secret.vercel.app/32 to generate
NEXTAUTH_SECRET=your_nextauth_secret_key
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Upstash Redis (REST API)
# Obtain from Upstash Console: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional Redis keyspace isolation when Preview and Production share one Upstash database.
# Leave UNSET in production to preserve existing unprefixed production data.
# Set to staging: ONLY on the staging deployment. Never use the same prefix in both environments.
# REDIS_KEY_PREFIX=staging:

# Vercel Blob (create a PUBLIC Blob store in Vercel Storage for chat attachments)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# Pusher Channels
# Obtain from Pusher Dashboard: https://dashboard.pusher.com/
PUSHER_APP_ID=your_pusher_app_id
NEXT_PUBLIC_PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap2
PUSHER_APP_CLUSTER=ap2


# Vercel Cron authentication (set the same secret in Vercel project settings)
# Generate a random value; scheduled cleanup and the authenticated Redis health probe require it.
CRON_SECRET=replace_with_a_long_random_secret

# Email verification and password recovery (Nodemailer + Gmail SMTP)
# Enable Google 2-Step Verification, then create an App Password:
# https://myaccount.google.com/apppasswords
# Use the 16-character App Password, not your normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM=Chat+ <your-gmail-address@gmail.com>

# Platform SuperAdmin allowlist (comma-separated verified account emails)
# Only deployment operators can change this value. Never store this in a client-exposed variable.
SUPERADMIN_EMAILS=admin@example.com
